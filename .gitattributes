# Normalise line endings to LF in the repo; check out as-is on all platforms
* text=auto eol=lf

# Force LF for shell scripts and YAML (Windows editors sometimes convert these)
*.sh    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.tf    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Binaries — no line-ending conversion
*.png   binary
*.jpg   binary
*.ico   binary
